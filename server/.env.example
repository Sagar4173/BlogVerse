# Environment Configuration for BlogVerse Server
# Copy this file to .env and fill in the actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB connection string
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/blogverse

# For MongoDB Atlas (replace with your actual connection string):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/blogverse?retryWrites=true&w=majority

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Node environment (development, production, test)
NODE_ENV=development

# Server port
PORT=5000

# Frontend URL (important for CORS)
CLIENT_URL=http://localhost:5173

# Additional allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================

# JWT secret key (MUST be at least 32 characters for security)
# Generate a secure random string for production
JWT_SECRET=your-super-secret-jwt-key-that-is-at-least-32-characters-long

# JWT expiration time (default: 24h)
JWT_EXPIRES_IN=24h

# =============================================================================
# CLOUDINARY CONFIGURATION (for image uploads)
# =============================================================================

# Get these from your Cloudinary dashboard
# Sign up at: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# Email service provider
EMAIL_SERVICE=gmail

# Your email credentials
EMAIL_USER=your-email@gmail.com

# For Gmail, use App Password instead of regular password
# Enable 2FA first, then generate App Password from Google Account settings
EMAIL_PASSWORD=your-gmail-app-password

# Email sender name (optional)
EMAIL_FROM_NAME=BlogVerse Team

# =============================================================================
# OPTIONAL CONFIGURATIONS
# =============================================================================

# Enable/disable email verification (true/false)
REQUIRE_EMAIL_VERIFICATION=true

# OTP expiration time in minutes (default: 10)
OTP_EXPIRATION_MINUTES=10

# Password reset token expiration in minutes (default: 60)
RESET_TOKEN_EXPIRATION_MINUTES=60

# Maximum file upload size in MB (default: 5)
MAX_FILE_SIZE_MB=5

# Rate limiting - requests per window
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Auth rate limiting - requests per window
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_MS=900000

# =============================================================================
# SECURITY CONFIGURATIONS
# =============================================================================

# Enable HTTPS redirect in production (true/false)
FORCE_HTTPS=false

# Session secret for additional security
SESSION_SECRET=your-session-secret-key

# =============================================================================
# ANALYTICS & MONITORING (Optional)
# =============================================================================

# MongoDB connection pool size
DB_POOL_SIZE=10

# Enable request logging (true/false)
ENABLE_REQUEST_LOGGING=true

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# =============================================================================
# DEVELOPMENT CONFIGURATIONS
# =============================================================================

# Enable debug mode (true/false)
DEBUG=false

# Disable SSL verification for development (not recommended for production)
NODE_TLS_REJECT_UNAUTHORIZED=1

# =============================================================================
# IMPORTANT SECURITY NOTES
# =============================================================================
#
# 1. Never commit this file to version control with actual values
# 2. Use strong, unique passwords and secrets
# 3. Enable 2FA on all external services (Gmail, MongoDB Atlas, Cloudinary)
# 4. Regularly rotate your JWT secret and other sensitive keys
# 5. Use environment-specific values for each deployment
# 6. For production, consider using a secrets management service
#
# =============================================================================
