# Environment Configuration for BlogVerse Client
# Copy this file to .env and fill in the actual values

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API base URL
# For development (local server):
VITE_API_URL=http://localhost:5000/api

# For production (replace with your actual API URL):
# VITE_API_URL=https://your-api-domain.vercel.app/api

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application name
VITE_APP_NAME=BlogVerse

# Application version
VITE_APP_VERSION=1.0.0

# Application description
VITE_APP_DESCRIPTION=A modern blogging platform for writers and readers

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable dark mode toggle
VITE_ENABLE_DARK_MODE=true

# Enable/disable user registration
VITE_ENABLE_REGISTRATION=true

# Enable/disable social login (future feature)
VITE_ENABLE_SOCIAL_LOGIN=false

# Enable/disable PWA features
VITE_ENABLE_PWA=true

# Enable/disable analytics tracking
VITE_ENABLE_ANALYTICS=false

# =============================================================================
# THIRD-PARTY INTEGRATIONS (Optional)
# =============================================================================

# Google Analytics ID (if analytics enabled)
# VITE_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# Google reCAPTCHA site key (if using reCAPTCHA)
# VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Social media share URLs
VITE_FACEBOOK_SHARE_URL=https://www.facebook.com/sharer/sharer.php
VITE_TWITTER_SHARE_URL=https://twitter.com/intent/tweet
VITE_LINKEDIN_SHARE_URL=https://www.linkedin.com/sharing/share-offsite/

# =============================================================================
# UI/UX CONFIGURATION
# =============================================================================

# Default theme (light/dark)
VITE_DEFAULT_THEME=light

# Items per page for pagination
VITE_ITEMS_PER_PAGE=12

# Maximum file size for uploads (in bytes)
VITE_MAX_FILE_SIZE=5242880

# Supported image formats
VITE_SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,gif,webp

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Enable service worker caching
VITE_ENABLE_SW_CACHE=true

# API request timeout (in milliseconds)
VITE_API_TIMEOUT=30000

# Image lazy loading threshold (in pixels)
VITE_LAZY_LOAD_THRESHOLD=100

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable development tools (Redux DevTools, etc.)
VITE_ENABLE_DEV_TOOLS=true

# Enable debug logging
VITE_ENABLE_DEBUG_LOGGING=false

# Mock API for development (true/false)
VITE_USE_MOCK_API=false

# =============================================================================
# CONTACT & SUPPORT
# =============================================================================

# Support email
VITE_SUPPORT_EMAIL=support@blogverse.com

# Contact form endpoint (if different from main API)
# VITE_CONTACT_FORM_URL=https://your-contact-api.com/contact

# =============================================================================
# SEO CONFIGURATION
# =============================================================================

# Default meta title
VITE_DEFAULT_TITLE=BlogVerse - Modern Blogging Platform

# Default meta description
VITE_DEFAULT_DESCRIPTION=Discover amazing stories, share your thoughts, and connect with writers from around the world on BlogVerse.

# Default meta keywords
VITE_DEFAULT_KEYWORDS=blog,writing,stories,articles,community,publishing

# Default meta author
VITE_DEFAULT_AUTHOR=BlogVerse Team

# Social media meta image
VITE_DEFAULT_OG_IMAGE=/blogverse-og-image.jpg

# =============================================================================
# SOCIAL MEDIA LINKS
# =============================================================================

# Official social media accounts (optional)
VITE_TWITTER_URL=https://twitter.com/blogverse
VITE_FACEBOOK_URL=https://facebook.com/blogverse
VITE_INSTAGRAM_URL=https://instagram.com/blogverse
VITE_LINKEDIN_URL=https://linkedin.com/company/blogverse

# =============================================================================
# LEGAL & COMPLIANCE
# =============================================================================

# Terms of Service URL
VITE_TERMS_URL=/terms-of-service

# Privacy Policy URL
VITE_PRIVACY_URL=/privacy-policy

# Cookie Policy URL
VITE_COOKIE_POLICY_URL=/cookie-policy

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
#
# 1. All environment variables for Vite must be prefixed with 'VITE_'
# 2. These variables are exposed to the client-side code
# 3. Never include sensitive information like API keys or secrets
# 4. Values are available at build time, not runtime
# 5. Use different values for development, staging, and production
# 6. Boolean values should be strings: 'true' or 'false'
#
# =============================================================================
